ronment-variables","content":"noVNC host mapping port. Official templates publish only this remote-desktop port.","locale":"en"},"2151":{"id":"/en/docs/guide/deploy/docker-104","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#environment-variables","content":"`ONEBOT_HTTP_PORT`","locale":"en"},"2152":{"id":"/en/docs/guide/deploy/docker-105","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#environment-variables","content":"`3000`","locale":"en"},"2153":{"id":"/en/docs/guide/deploy/docker-106","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#environment-variables","content":"OneBot HTTP host mapping port.","locale":"en"},"2154":{"id":"/en/docs/guide/deploy/docker-107","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#environment-variables","content":"`ONEBOT_WS_PORT`","locale":"en"},"2155":{"id":"/en/docs/guide/deploy/docker-108","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#environment-variables","content":"`3001`","locale":"en"},"2156":{"id":"/en/docs/guide/deploy/docker-109","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#environment-variables","content":"OneBot WebSocket host mapping port.","locale":"en"},"2157":{"id":"/en/docs/guide/deploy/docker-110","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#environment-variables","content":"Environment variables take precedence over `runtime.json`. To restrict the WebUI to the container itself, set `SNOWLUMA_WEBUI_HOST` to `127.0.0.1` and recreate the container.","locale":"en"},"2158":{"id":"/en/docs/guide/deploy/docker-111","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#volumes","content":"Volume","locale":"en"},"2159":{"id":"/en/docs/guide/deploy/docker-112","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#volumes","content":"Container path","locale":"en"},"2160":{"id":"/en/docs/guide/deploy/docker-113","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#volumes","content":"Contents","locale":"en"},"2161":{"id":"/en/docs/guide/deploy/docker-114","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#volumes","content":"`qq-gateway-data`","locale":"en"},"2162":{"id":"/en/docs/guide/deploy/docker-115","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#volumes","content":"`/app/data`","locale":"en"},"2163":{"id":"/en/docs/guide/deploy/docker-116","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#volumes","content":"SnowLuma config, cache, SQLite. Includes `config/onebot.json` and `config/runtime.json`.","locale":"en"},"2164":{"id":"/en/docs/guide/deploy/docker-117","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#volumes","content":"`qq-client-config`","locale":"en"},"2165":{"id":"/en/docs/guide/deploy/docker-118","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#volumes","content":"`/app/.config`","locale":"en"},"2166":{"id":"/en/docs/guide/deploy/docker-119","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#volumes","content":"QQ client config.","locale":"en"},"2167":{"id":"/en/docs/guide/deploy/docker-120","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#volumes","content":"`qq-client-data`","locale":"en"},"2168":{"id":"/en/docs/guide/deploy/docker-121","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#volumes","content":"`/app/.local/share`","locale":"en"},"2169":{"id":"/en/docs/guide/deploy/docker-122","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#volumes","content":"QQ user data (login state, cache).","locale":"en"},"2170":{"id":"/en/docs/guide/deploy/docker-123","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#volumes","content":"**Don't delete these on upgrade** — you'll lose login state and configuration.","locale":"en"},"2171":{"id":"/en/docs/guide/deploy/docker-124","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#first-time-login","content":"Open `http://<host>:6081/` (noVNC) and enter the remote-desktop password from the logs (see **Remote-desktop password**).","locale":"en"},"2172":{"id":"/en/docs/guide/deploy/docker-125","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#first-time-login","content":"Inside the remote desktop you'll see QQ already running. Scan the QR to log in.","locale":"en"},"2173":{"id":"/en/docs/guide/deploy/docker-126","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#first-time-login","content":"Once login completes the hook auto-switches from passive observation to working mode — no need to click Load in the WebUI.","locale":"en"},"2174":{"id":"/en/docs/guide/deploy/docker-127","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#first-time-login","content":"Open `http://<host>:5099/` for the SnowLuma WebUI.","locale":"en"},"2175":{"id":"/en/docs/guide/deploy/docker-128","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#finding-the-webui-bootstrap-password","content":"On a fresh data volume the first launch logs a one-time password:","locale":"en"},"2176":{"id":"/en/docs/guide/deploy/docker-129","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#finding-the-webui-bootstrap-password","content":"Just the password string:","locale":"en"},"2177":{"id":"/en/docs/guide/deploy/docker-130","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#finding-the-webui-bootstrap-password","content":"The bootstrap password is logged **only on a brand-new data volume's first boot**. Reusing the volume or restarting won't regenerate it.","locale":"en"},"2178":{"id":"/en/docs/guide/deploy/docker-131","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#running-multiple-qq-accounts","content":"Linux QQ ships a single-instance lock — clicking the QQ icon again on a desktop that already has one running just focuses the existing window, it doesn't start a second process. The lock file lives at `$HOME/.config/QQ/SingletonLock`, so the solution is to give each instance its &#x2A;*own `HOME`**.","locale":"en"},"2179":{"id":"/en/docs/guide/deploy/docker-132","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#running-multiple-qq-accounts","content":"SnowLuma needs no extra configuration: HookManager walks every QQ main process it can find, injects the hook into each, and spins up a separate `OneBotInstance` per UIN with its own `config/onebot_<uin>.json`.","locale":"en"},"2180":{"id":"/en/docs/guide/deploy/docker-133","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#recommended-auto-start-through-an-environment-variable","content":"Mount one dedicated volume per extra account, then list the corresponding container paths in `SNOWLUMA_EXTRA_QQ_HOMES`. The list can be comma- or space-separated:","locale":"en"},"2181":{"id":"/en/docs/guide/deploy/docker-134","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#recommended-auto-start-through-an-environment-variable","content":"On boot, the container generates one supervisor program per extra `HOME`. Each extra QQ runs as the `snowluma` user with the same `DISPLAY=:1` and the same `SNOWLUMA_QQ_FLAGS`, so injection won't fail because a manual `docker exec` accidentally launched QQ as root.","locale":"en"},"2182":{"id":"/en/docs/guide/deploy/docker-135","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#recommended-auto-start-through-an-environment-variable","content":"Check process status:","locale":"en"},"2183":{"id":"/en/docs/guide/deploy/docker-136","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#temporarily-launch-one-extra-account-by-hand","content":"For a one-off launch, keep the user and environment explicit. The important bit is: **do not run the extra QQ as root**.","locale":"en"},"2184":{"id":"/en/docs/guide/deploy/docker-137","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#temporarily-launch-one-extra-account-by-hand","content":"If `/app/qq-acct2` is not mounted to a volume, recreating the container loses that account's login state. For long-term use, prefer the Compose setup above.","locale":"en"},"2185":{"id":"/en/docs/guide/deploy/docker-138","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#caveats","content":"**One HOME per QQ instance** — never share a `HOME` between two QQs; they'll fight over the lock file.","locale":"en"},"2186":{"id":"/en/docs/guide/deploy/docker-139","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#caveats","content":"**Resources**: each QQ is a full Chromium process, \\~300-500 MB RAM. The default `--shm-size=1g` is fine for one; bump to `2gb`+ for multi-account.","locale":"en"},"2187":{"id":"/en/docs/guide/deploy/docker-140","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#caveats","content":"**All windows share the same Xvfb desktop**: noVNC shows every QQ window; minimize the ones you've already logged into. Hook keeps working regardless of window state.","locale":"en"},"2188":{"id":"/en/docs/guide/deploy/docker-141","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#caveats","content":"**WebUI lists every UIN automatically**: no manual configuration — SnowLuma surfaces each new account in the WebUI and `get_login_info` returns the new UINs once login completes.","locale":"en"},"2189":{"id":"/en/docs/guide/deploy/docker-142","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#caveats","content":"**Do not rely on desktop autostart folders**: the image uses `fluxbox`, not an XFCE/GNOME session. `~/.config/autostart/*.desktop` may not be read. Let supervisor handle multi-account boot instead.","locale":"en"},"2190":{"id":"/en/docs/guide/deploy/docker-143","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#auto-injection","content":"The image defaults to `SNOWLUMA_HOOK_AUTOLOAD=1`: when the container starts, the hook is injected into the QQ process in passive-observe mode. Once you scan-login, the hook auto-promotes to working mode. supervisor also restarts QQ on crash through the same flow.","locale":"en"},"2191":{"id":"/en/docs/guide/deploy/docker-144","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#turning-it-off","content":"If you prefer the legacy \"manual Load via WebUI\" workflow:","locale":"en"},"2192":{"id":"/en/docs/guide/deploy/docker-145","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#turning-it-off","content":"Or set `SNOWLUMA_HOOK_AUTOLOAD: 0` in `docker-compose.yml`, or edit `/app/data/config/runtime.json` inside the volume to `\"hookAutoLoad\": false`. Environment variables win.","locale":"en"},"2193":{"id":"/en/docs/guide/deploy/docker-146","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#common-ops","content":"Shell into the container:","locale":"en"},"2194":{"id":"/en/docs/guide/deploy/docker-147","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#common-ops","content":"Follow logs:","locale":"en"},"2195":{"id":"/en/docs/guide/deploy/docker-148","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#common-ops","content":"Just SnowLuma's own logs (filter out QQ's noisy output):","locale":"en"},"2196":{"id":"/en/docs/guide/deploy/docker-149","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#common-ops","content":"Browse the data directory:","locale":"en"},"2197":{"id":"/en/docs/guide/deploy/docker-150","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#common-ops","content":"Edit OneBot config and restart:","locale":"en"},"2198":{"id":"/en/docs/guide/deploy/docker-151","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#port-remapping","content":"If a host port is taken, just shift the host side; container ports stay the same. Example moving OneBot HTTP to host `8080`:","locale":"en"},"2199":{"id":"/en/docs/guide/deploy/docker-152","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#port-remapping","content":"Or via env (the Compose template already supports it):","locale":"en"},"2200":{"id":"/en/docs/guide/deploy/docker-153","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#building-the-image-yourself","content":"Useful when you need an unreleased SnowLuma build:","locale":"en"},"2201":{"id":"/en/docs/guide/deploy/docker-154","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#building-the-image-yourself","content":"Or let the script pull the latest release:","locale":"en"},"2202":{"id":"/en/docs/guide/deploy/docker-155","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#building-the-image-yourself","content":"Multi-arch manifests are merged by CI (`.github/workflows/docker-image.yml`); the local script only builds a single platform.","locale":"en"},"2203":{"id":"/en/docs/guide/deploy/docker-156","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#security-notes","content":"SnowLuma's native addon injects code into the QQ process; the container needs `SYS_PTRACE` and `seccomp=unconfined`. Only run on trusted hosts.","locale":"en"},"2204":{"id":"/en/docs/guide/deploy/docker-157","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#security-notes","content":"Do not expose noVNC / WebUI / OneBot ports raw on the public internet. There is no shared default remote-desktop password, but an open port is still enough for someone else to connect.","locale":"en"},"2205":{"id":"/en/docs/guide/deploy/docker-158","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#security-notes","content":"Comply with NTQQ / Tencent's terms of service plus SnowLuma's and its dependencies' open-source licenses.","locale":"en"},"2206":{"id":"/en/docs/guide/deploy","page_id":"/en/docs/guide/deploy","type":"page","content":"Deployment","breadcrumbs":["Docs","Deployment"],"tags":[],"url":"/en/docs/guide/deploy","locale":"en"},"2207":{"id":"/en/docs/guide/deploy-0","page_id":"/en/docs/guide/deploy","tags":[],"type":"text","url":"/en/docs/guide/deploy","content":"Compare SnowLuma's deployment methods and pick one","locale":"en"},"2208":{"id":"/en/docs/guide/deploy-1","page_id":"/en/docs/guide/deploy","type":"heading","tags":[],"url":"/en/docs/guide/deploy#comparison","content":"Comparison","locale":"en"},"2209":{"id":"/en/docs/guide/deploy-2","page_id":"/en/docs/guide/deploy","type":"heading","tags":[],"url":"/en/docs/guide/deploy#updating","content":"Updating","locale":"en"},"2210":{"id":"/en/docs/guide/deploy-3","page_id":"/en/docs/guide/deploy","type":"heading","tags":[],"url":"/en/docs/guide/deploy#after-deploying","content":"After deploying","locale":"en"},"2211":{"id":"/en/docs/guide/deploy-4","page_id":"/en/docs/guide/deploy","tags":[],"type":"text","url":"/en/docs/guide/deploy","content":"SnowLuma runs in several environments, but the core requirement is always the same: it must be able to run QQ, inject a hook into the QQ process, and let you scan a login QR. Difficulty varies a lot between environments — the table below helps you pick.","locale":"en"},"2212":{"id":"/en/docs/guide/deploy-5","page_id":"/en/docs/guide/deploy","tags":[],"type":"text","url":"/en/docs/guide/deploy","content":"Not sure which to choose? See the decision table in Quick Start, or just pick **Docker on Linux**.","locale":"en"},"2213":{"id":"/en/docs/guide/deploy-6","page_id":"/en/docs/guide/deploy","tags":[],"type":"text","url":"/en/docs/guide/deploy#comparison","content":"Method","locale":"en"},"2214":{"id":"/en/docs/guide/deploy-7","page_id":"/en/docs/guide/deploy","tags":[],"type":"text","url":"/en/docs/guide/deploy#comparison","content":"Platform","locale":"en"},"2215":{"id":"/en/docs/guide/deploy-8","page_id":"/en/docs/guide/deploy","tags":[],"type":"text","url":"/en/docs/guide/deploy#comparison","content":"Difficulty","locale":"en"},"2216":{"id":"/en/docs/guide/deploy-9","page_id":"/en/docs/guide/deploy","tags":[],"type":"text","url":"/en/docs/guide/deploy#comparison","content":"Recommended","locale":"en"},"221