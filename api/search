","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#image","content":"`node:22-bookworm-slim`","locale":"en"},"2072":{"id":"/en/docs/guide/deploy/docker-31","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#image","content":"Bundled","locale":"en"},"2073":{"id":"/en/docs/guide/deploy/docker-32","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#image","content":"Linux QQ, Xvfb, VNC, noVNC, supervisord, SnowLuma `lite`","locale":"en"},"2074":{"id":"/en/docs/guide/deploy/docker-33","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#image","content":"The image does **not** rebuild SnowLuma — it consumes the prebuilt `lite` tarball from each SnowLuma GitHub Release, so the release and the image build are decoupled.","locale":"en"},"2075":{"id":"/en/docs/guide/deploy/docker-34","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#ports","content":"Port","locale":"en"},"2076":{"id":"/en/docs/guide/deploy/docker-35","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#ports","content":"Purpose","locale":"en"},"2077":{"id":"/en/docs/guide/deploy/docker-36","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#ports","content":"`6081`","locale":"en"},"2078":{"id":"/en/docs/guide/deploy/docker-37","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#ports","content":"noVNC (browser desktop for QR login)","locale":"en"},"2079":{"id":"/en/docs/guide/deploy/docker-38","page_id":"/en/docs/guide/deploy/docker","tags":[],"type":"text","url":"/en/docs/guide/deploy/docker#ports","content":"`5099`","locale":"en"},"2080":{"id":"/en/docs/guide/deploy/docker-39","page_id":"/en/docs/guide/deploy/docker"