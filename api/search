s/guide/deploy/baota","tags":[],"type":"text","url":"/en/docs/guide/deploy/baota#import--install","content":"**VNC Password**: if the panel asks for one, set a strong password of your own. Do not reuse a fixed value from old docs or sample posts. The official image has no public default password.","locale":"en"},"2564":{"id":"/en/docs/guide/deploy/baota-12","page_id":"/en/docs/guide/deploy/baota","tags":[],"type":"text","url":"/en/docs/guide/deploy/baota#import--install","content":"**WebUI Port**: default `5099`","locale":"en"},"2565":{"id":"/en/docs/guide/deploy/baota-13","page_id":"/en/docs/guide/deploy/baota","tags":[],"type":"text","url":"/en/docs/guide/deploy/baota#import--install","content":"**noVNC Port**: default `6081`, browser-based remote desktop","locale":"en"},"2566":{"id":"/en/docs/guide/deploy/baota-14","page_id":"/en/docs/guide/deploy/baota","tags":[],"type":"text","url":"/en/docs/guide/deploy/baota#import--install","content":"**OneBot WS Port**: default `3001`, for bot framework integration","locale":"en"},"2567":{"id":"/en/docs/guide/deploy/baota-15","page_id":"/en/docs/guide/deploy/baota","tags":[],"type":"text","url":"/en/docs/guide/deploy/baota#import--install","content":"Once installed, the container appears in BT Panel's Docker management — logs, start/stop, and editing are all available through the panel UI.","locale":"en"},"2568":{"id":"/en/docs/guide/deploy/baota-16","page_id":"/en/docs/guide/deploy/baota","tags":[],"type":"text","url":"/en/docs/guide/deploy/baota#first-login","content":"After startup, it works exactly the same as standard Docker deployment:","locale":"en"},"2569":{"id":"/en/docs/guide/deploy/baota-17","page_id":"/en/docs/guide/deploy/baota","tags":[],"type":"text","url":"/en/docs/guide/deploy/baota#first-login","content":"Open `http://<server-ip>:6081/` (noVNC) in a browser and enter your VNC password","locale":"en"},"2570":{"id":"/en/docs/guide/deploy/baota-18","page_id":"/en/docs/guide/deploy/baota","tags":[],"type":"tex